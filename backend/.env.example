# 数据库
DATABASE_URL=postgresql+asyncpg://dev:dev123@127.0.0.1:5432/test_platform

# JWT
JWT_SECRET_KEY=dev-secret-key-change-me-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 执行
DEFAULT_EXECUTION_TIMEOUT=1800
MAX_EXECUTION_TIMEOUT=7200

# 多 APP 档案灰度：off / compat / required；compat 仅对下列项目自动注入通用档案
APP_PROFILE_FEATURE_MODE=off
APP_PROFILE_ENABLED_PROJECT_IDS=

# Worker：embedded（默认随 FastAPI 启动）/ external（独立 worker.py）/ disabled
WORKER_MODE=embedded
WORKER_ID=worker-001
WORKER_POLL_INTERVAL=2
WORKER_CLAIM_STALE_MINUTES=10
WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Agent
AGENT_HEARTBEAT_INTERVAL=30
AGENT_HEARTBEAT_TIMEOUT=120
MIN_AGENT_VERSION=1.0.0
INTERNAL_TOKEN=dev-internal-token-change-me
AGENT_WS_MAX_FRAME_BYTES=1048576
AGENT_WS_MAX_PRE_REGISTER_MESSAGES=20
AGENT_WS_REGISTER_TIMEOUT_SECONDS=30

# 存储
REPORTS_BASE_PATH=D:/sjs/app_auto_test/data/reports
MAX_UPLOAD_SIZE=524288000

# 清理
REPORT_RETENTION_DAYS=90
SCREENSHOT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8001"]

# /metrics 仅在 Prometheus 与后端同机时设为 true；远程采集请使用网络白名单或反向代理鉴权
METRICS_REQUIRE_LOOPBACK=false
